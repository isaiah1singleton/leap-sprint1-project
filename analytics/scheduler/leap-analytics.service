[Unit]
Description=Refresh DuckDB analytics and activate Superset snapshot
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/leap-sprint1-project
ExecStart=/usr/bin/python3 /home/ec2-user/leap-sprint1-project/analytics/scheduler/refresh.py
TimeoutStartSec=3h
UMask=0077
