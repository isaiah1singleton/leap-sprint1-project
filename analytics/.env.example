# Existing Docker network containing your PostgreSQL container.
OLTP_NETWORK=backend_default
# Service DNS name and INTERNAL port when ETL shares PostgreSQL's network.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=leap
POSTGRES_USER=leap
POSTGRES_PASSWORD=
# Choose a NEW identifier for every extraction (letters, digits, hyphens).
BATCH_ID=batch-001
# NEW immutable generation for every warehouse publication.
SNAPSHOT_ID=snapshot-001
# Required only for the bi profile. Generate strong independent values locally.
SUPERSET_SECRET_KEY=
SUPERSET_DB_PASSWORD=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=admin@example.test
SUPERSET_PORT=8088
